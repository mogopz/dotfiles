{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.codex/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "command": "bash \"$HOME/.codex/hooks/block-dangerous-command.sh\"",
            "statusMessage": "Checking command policy",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  }
}
